@import "tailwindcss";

@theme {
  --color-mkdir-black: #05070a;
  --color-mkdir-panel: #0b0e13;
  --color-mkdir-panel-soft: #11151b;

  --color-mkdir-gold-dark: #855a17;
  --color-mkdir-gold: #d6aa4d;
  --color-mkdir-gold-light: #f1d27a;

  --color-mkdir-neon-blue: #18d6ff;
  --color-mkdir-neon-purple: #8a4dff;
  --color-mkdir-neon-red: #e33a48;

  --font-brand: Georgia, "Times New Roman", serif;
}

@layer base {
  :root {
    color-scheme: dark;
    background: var(--color-mkdir-black);
  }

  html {
    scroll-behavior: smooth;
    background: var(--color-mkdir-black);
  }

  body {
    min-width: 320px;
    margin: 0;
    background:
      radial-gradient(circle at 15% 5%, rgb(24 214 255 / 4%), transparent 28%),
      radial-gradient(circle at 85% 15%, rgb(138 77 255 / 4%), transparent 26%),
      var(--color-mkdir-black);
    color: #f4f4f5;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  button,
  a {
    -webkit-tap-highlight-color: transparent;
  }

  ::selection {
    background: rgb(214 170 77 / 35%);
    color: white;
  }
}

@layer components {
  .brand-mark {
    background:
      linear-gradient(145deg, #805412, #f1d27a 45%, #9f6a1b);
    border: 1px solid rgb(255 233 166 / 60%);
    box-shadow:
      0 0 0 1px rgb(24 214 255 / 10%),
      0 0 18px rgb(24 214 255 / 12%),
      inset 0 1px 1px rgb(255 255 255 / 35%);
  }

  .brand-wordmark {
    color: var(--color-mkdir-gold-light);
    text-shadow: 0 0 14px rgb(24 214 255 / 10%);
  }

  .hex-pattern {
    background-image:
      linear-gradient(30deg, rgb(214 170 77 / 16%) 12%, transparent 12.5%, transparent 87%, rgb(214 170 77 / 16%) 87.5%),
      linear-gradient(150deg, rgb(24 214 255 / 9%) 12%, transparent 12.5%, transparent 87%, rgb(24 214 255 / 9%) 87.5%);
    background-size: 76px 132px;
    mask-image: linear-gradient(90deg, transparent, black 25%, black 75%, transparent);
  }

  .card-surface {
    background:
      linear-gradient(120deg, transparent 25%, rgb(255 255 255 / 4%) 38%, transparent 52%),
      repeating-linear-gradient(0deg, rgb(255 255 255 / 1.5%) 0 1px, transparent 1px 4px),
      linear-gradient(145deg, #181b20, #07090c);
  }

  .neon-orb {
    position: absolute;
    width: 18rem;
    height: 18rem;
    border-radius: 9999px;
    filter: blur(90px);
    opacity: 0.16;
    pointer-events: none;
  }

  .neon-orb-blue {
    background: var(--color-mkdir-neon-blue);
  }

  .neon-orb-purple {
    background: var(--color-mkdir-neon-purple);
  }

  .neon-orb-red {
    background: var(--color-mkdir-neon-red);
  }
}
